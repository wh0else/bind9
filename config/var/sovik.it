$TTL    3600
@       IN      SOA     ns01.sovik.it. hostmaster.sovik.it. (
                        2026081801      ; Serial
                        3600            ; Refresh
                        900             ; Retry
                        604800          ; Expire
                        3600 )          ; Negative cache TTL

@       IN      NS      ns01.sovik.it.
@       IN      NS      ns02.sovik.it.

; --- delegations ---
; nat1.sovik.it is NOT resolved locally - delegated to the forward zone
; defined in named.conf.local (dynamic DNS, TTL 60)
nat1                    IN      NS      nat1.sovik.it.

